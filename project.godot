; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Centinela 2.0"
config/version="0.26.0-preview"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/GameState.gd"
WebBridge="*res://scripts/WebBridge.gd"
SaveManager="*res://scripts/SaveManager.gd"
SyncManager="*res://scripts/SyncManager.gd"
AudioManager="*res://scripts/AudioManager.gd"

[display]

window/size/viewport_width=768
window/size/viewport_height=448
window/size/window_width_override=1152
window/size/window_height_override=672
window/stretch/mode="canvas_items"

